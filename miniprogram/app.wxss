page{background:#f5f6f2;color:#253b31;font-family:sans-serif;font-size:28rpx}.page{padding:40rpx}.eyebrow{font-size:20rpx;letter-spacing:3rpx;color:#8c9d7b}.title{font-size:44rpx;font-weight:600;margin:20rpx 0}.muted{color:#8a9780;font-size:24rpx;line-height:1.8}.card{background:white;border:1rpx solid #e3e8dc;border-radius:20rpx;padding:32rpx;margin:24rpx 0}.primary{background:#173d32;color:#eaf4da;border-radius:12rpx;font-size:28rpx;margin-top:26rpx}input,picker{border:1rpx solid #dee5d5;border-radius:10rpx;padding:20rpx;margin:14rpx 0;font-size:26rpx}button::after{border:0}.notice{background:#eaf0de;padding:24rpx;font-size:23rpx;color:#73835f;line-height:1.8;border-radius:10rpx;margin:20rpx 0}.row{display:flex;justify-content:space-between;align-items:center}.badge{background:#eff4e6;color:#77975b;border-radius:8rpx;padding:8rpx 14rpx;font-size:22rpx}.price{font-size:38rpx;color:#5e7f4b}.label{margin-top:24rpx;font-size:24rpx;color:#7d8c6d}.event{padding:18rpx 0;border-bottom:1rpx solid #e7ecdf;font-size:23rpx}.error{color:#b36857;font-size:24rpx}.secondary{font-size:25rpx;color:#668154;background:#eaf0df;margin-top:20rpx}
