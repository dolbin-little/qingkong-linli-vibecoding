<view class="page"><view class="eyebrow">DELIVERY TRACKING</view><view class="title">我的配送与归还</view><view class="error">{{error}}</view><view class="card" wx:for="{{orders}}" wx:key="id"><view class="row"><view>{{item.productName}} ×{{item.quantity}}</view><view class="badge">{{item.label}}</view></view><view class="muted">{{item.id}} · {{item.address}}</view><view class="muted">无人机 {{item.drone_id || '待分配'}} · 模拟金额 ¥{{item.displayAmount}}</view><view class="event" wx:for="{{item.events}}" wx:for-item="event" wx:key="index">T+{{event.at}} 分钟 · {{event.text}}</view><button wx:if="{{item.canReturn}}" class="primary" data-id="{{item.id}}" data-action="return" bindtap="act">申请无人机回收</button><button wx:if="{{item.canCancel}}" class="secondary" data-id="{{item.id}}" data-action="cancel" bindtap="act">取消订单 / 模拟退款</button></view><view class="notice" wx:if="{{!orders.length}}">还没有订单，返回居民服务创建第一笔配送。</view></view>
